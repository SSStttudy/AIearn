PORT=8787
DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/ailearn
# 可选：32 字节密钥的 base64 或 64 位 hex。未设置时自动写入 data/.ailearn-secret
# AILEARN_SECRET_KEY=

# 局域网共享测试接口。必须使用新 Key，绝不能提交真实值。
# AILEARN_TEST_API_KEY=

# 仅在 HTTPS 部署时设为 true。
COOKIE_SECURE=false

# 允许携带登录 Cookie 的网页来源，局域网测试时替换为本机 IPv4。
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.114:5173
